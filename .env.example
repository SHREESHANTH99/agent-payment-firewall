# -----------------------------------------------------------------------------
# Agent Payment Firewall - Environment Configuration Template
# Copy this file to .env and adjust variables for local development.
# -----------------------------------------------------------------------------

# Environment mode: development | production | test
ENV=development

# Execution mode: paypal | dry_run
# In dry_run, all checkpoints evaluate but funds are not moved via PayPal.
EXECUTION_MODE=paypal

# PayPal Sandbox Configuration (Strictly Sandbox - live mode is forbidden)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id
PAYPAL_TEST_RECEIVER_EMAIL=sb-receiver@personal.example.com

# PostgreSQL Database (Source of Truth & SHA-256 Hash Chain)
# Accepts postgres://, postgresql://, or postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/firewall

# Redis (Atomic Budget Reservation, Sliding Rate Limit, Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Operator Authorization Secret (Must be >= 24 chars in production)
OPERATOR_TOKEN=dev-operator-secret-token-min-24-chars-long

# Agent API Keys (JSON mapping of SecretKey -> AgentID)
AGENT_API_KEYS={"dev-agent-secret-key-1": "agent-alpha-001"}

# LLM Risk Inspection Layer (Canary & Judge)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_or_compatible_api_key
CANARY_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
JUDGE_FAIL_MODE=escalate
JUDGE_PROMPT_VERSION=2026.11.05.v2
JUDGE_DECISION_RULE=M0

# Rate Limiting & Request Guards
INTENTS_RATE_LIMIT_PER_MINUTE=60
WS_TICKET_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=262144

# Prometheus Metrics Token (Optional Bearer token to scrape /metrics)
METRICS_TOKEN=

# Frontend Dashboard Origin (CORS protection)
DASHBOARD_ORIGIN=http://localhost:3000

# Documentation endpoints (/docs, /redoc)
ENABLE_DOCS=false
